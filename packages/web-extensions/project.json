{
	"name": "kernel-vscode-extension",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/web-extensions/src",
	"projectType": "application",
	"tags": ["type:application"],
	"implicitDependencies": [
		"@adamziel/kernel",
		"@adamziel/kernel-node-js",
		"kernel-blocks"
	],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"dependsOn": ["^build"],
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"commands": ["node esbuild.js"],
				"cwd": "packages/web-extensions",
				"parallel": false
			},
			"configurations": {
				"production": {
					"commands": ["node esbuild.js"]
				}
			}
		},
		"dev": {
			"executor": "nx:run-commands",
			"dependsOn": ["^build"],
			"options": {
				"commands": ["node esbuild.js --watch"],
				"cwd": "packages/web-extensions",
				"parallel": false
			}
		},
		"watch": {
			"executor": "nx:run-commands",
			"dependsOn": ["^build"],
			"options": {
				"command": "node esbuild.js --watch",
				"cwd": "packages/web-extensions"
			}
		},
		"package": {
			"executor": "nx:run-commands",
			"dependsOn": ["build"],
			"outputs": ["{workspaceRoot}/dist/web-extensions/*.vsix"],
			"options": {
				"command": "vsce package --no-dependencies --out ../../dist/web-extensions",
				"cwd": "packages/web-extensions"
			}
		}
	}
}
