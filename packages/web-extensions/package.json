{
	"name": "kernel-vscode-extension",
	"displayName": "JavaScript Kernel",
	"description": "Run a JavaScript kernel with filesystem and terminal integration in VS Code Web",
	"version": "0.0.1",
	"publisher": "automattic",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"browser": "./dist/extension.js",
	"type": "module",
	"contributes": {
		"commands": [
			{
				"command": "kernel.openTerminal",
				"title": "Kernel: Open Terminal"
			},
			{
				"command": "kernel.restart",
				"title": "Kernel: Restart Kernel"
			}
		],
		"taskDefinitions": [
			{
				"type": "kernel-shell"
			}
		]
	},
	"scripts": {
		"dev": "npm run build:kernel && node esbuild.js --watch",
		"build": "npm run build:kernel && node esbuild.js",
		"build:kernel": "cd ../kernel && npm run build",
		"vscode:prepublish": "npm run build",
		"compile": "npm run build",
		"watch": "npm run dev",
		"package": "vsce package --no-dependencies",
		"publish": "vsce publish --no-dependencies"
	},
	"dependencies": {
		"@adamziel/kernel": "*"
	},
	"devDependencies": {
		"@types/vscode": "^1.85.0",
		"@vscode/vsce": "^2.22.0",
		"esbuild": "^0.19.11"
	}
}
