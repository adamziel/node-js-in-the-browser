{
	"name": "@adamziel/kernel-node-js",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/kernel-node-js",
	"projectType": "library",
	"tags": ["type:library"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/dist/kernel"],
			"options": {
				"command": "node build.js",
				"cwd": "packages/kernel-node-js"
			},
			"configurations": {
				"production": {
					"command": "NODE_ENV=production node build.js"
				}
			}
		},
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node build.js --watch",
				"cwd": "packages/kernel-node-js"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vitest run",
				"cwd": "packages/kernel-node-js"
			}
		},
		"test:smoke": {
			"executor": "nx:run-commands",
			"dependsOn": ["build"],
			"options": {
				"command": "node smoke-test.js",
				"cwd": "packages/kernel-node-js"
			}
		}
	}
}
